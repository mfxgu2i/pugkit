{
  "name": "pugkit",
  "version": "2.0.0",
  "description": "A build tool for Pug-based projects",
  "type": "module",
  "license": "MIT",
  "author": "mfxgu2i <mfxgu2i@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfxgu2i/pugkit.git",
    "directory": "packages/pugkit"
  },
  "bugs": "https://github.com/mfxgu2i/pugkit/issues",
  "homepage": "https://github.com/mfxgu2i/pugkit#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pugkit": "cli/index.mjs"
  },
  "keywords": [
    "pug",
    "ssg",
    "static-site-generator",
    "frontend-tooling"
  ],
  "exports": {
    ".": "./index.mjs",
    "./config": "./config/index.mjs"
  },
  "files": [
    "cli",
    "client",
    "config",
    "core",
    "generate",
    "index.mjs",
    "tasks",
    "transform",
    "utils"
  ],
  "peerDependencies": {
    "markuplint": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "markuplint": {
      "optional": true
    }
  },
  "dependencies": {
    "browserslist": "^4.28.0",
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.5",
    "glob": "^13.0.6",
    "htmlparser2": "^12.0.0",
    "idiomorph": "^0.7.4",
    "image-size": "^2.0.2",
    "js-beautify": "^2.0.3",
    "lightningcss": "^1.33.0",
    "picocolors": "^1.1.1",
    "pug": "^3.0.3",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.34.2",
    "sirv": "^3.0.2",
    "svgo": "^4.0.0"
  }
}
