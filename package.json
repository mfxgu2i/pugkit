{
  "name": "pugkit-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for pugkit packages",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "publish:pugkit": "cd packages/pugkit && npm publish",
    "publish:create-pugkit": "cd packages/create-pugkit && npm publish",
    "test:watch": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mfxgu2i/pugkit.git"
  },
  "author": "mfxgu2i <mfxgu2i@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "markuplint": "^4.18.3",
    "vitest": "^3.2.4"
  }
}
